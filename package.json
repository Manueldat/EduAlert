{
  "name": "edualert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:prepare": "node scripts/db.mjs prepare",
    "db:seed": "npm run seed -w backend",
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "node scripts/test.mjs",
    "test:unit": "node --test backend/test/academic.test.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
